; ============================================================
; md.mdp — Stage 5: production MD (200 ns x 3 replicas, 310 K, 1 bar)
; NO position restraints (no `define`, no `-r`). Restart from NPT (-t npt.cpt).
; Barostat: C-rescale (correct NPT ensemble + robust; matches Lemkul and our NPT).
;   (Parrinello-Rahman tau_p=5.0 is the classic equivalent — one-line swap below.)
; ============================================================

title           = ZNF263-HS7 production MD (200 ns)

integrator      = md
nsteps          = 100000000    ; 200 ns at 2 fs
dt              = 0.002

; ---- output: suppress bulky .trr, keep compressed xtc at 10 ps ----
nstxout         = 0
nstvout         = 0
nstfout         = 0
nstxout-compressed = 5000     ; frame every 10 ps (20000 frames over 200 ns)
compressed-x-grps = System
nstenergy       = 5000
nstlog          = 5000

continuation    = yes          ; read velocities/state from -t npt.cpt
constraint_algorithm = lincs
constraints     = h-bonds
lincs_iter      = 1
lincs_order     = 4

cutoff-scheme   = Verlet
nstlist         = 20
rlist           = 1.2
vdwtype         = cutoff
vdw-modifier    = force-switch
rvdw-switch     = 1.0
rvdw            = 1.2
coulombtype     = PME
rcoulomb        = 1.2
fourierspacing  = 0.12
pme-order       = 4

tcoupl          = V-rescale
tc-grps         = System
tau_t           = 1.0
ref_t           = 310

pcoupl          = C-rescale
pcoupltype      = isotropic
tau_p           = 5.0
ref_p           = 1.0
compressibility = 4.5e-5

pbc             = xyz
DispCorr        = no

